    {
      "name": "Settlement",
      "item": [
        {
          "name": "Completed Settlement",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const secret = pm.collectionVariables.get('settlement_secret');",
                  "",
                  "const rawBody = pm.variables.replaceIn(",
                  "    pm.request.body.raw",
                  ");",
                  "",
                  "const signature = CryptoJS.HmacSHA256(",
                  "    rawBody,",
                  "    secret",
                  ").toString(CryptoJS.enc.Hex);",
                  "",
                  "pm.request.headers.upsert({",
                  "    key: 'X-Settlement-Signature',",
                  "    value: signature",
                  "});",
                  "",
                  "console.log({",
                  "    rawBody,",
                  "    signature",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Settlement is accepted', function () {",
                  "    pm.response.to.have.status(202);",
                  "    pm.expect(pm.response.json().status).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
