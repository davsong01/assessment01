{
  "info": {
    "_postman_id": "635ccb24-7b78-4f3f-9c14-8119288efa4c",
    "name": "TuPay Backend Assessment (Ledger & Settlement Engine)",
    "description": "Postman collection for the TuPay Ledger & Settlement Engine assessment. Run Login, update totp_code with a current code, run 2FA Challenge, then Execute Swap. The collection automatically stores bearer_token, eat_token, and swap_reference.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "19588736"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql(true);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "if (response?.data?.token) {",
                  "    pm.collectionVariables.set('bearer_token', response.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Security",
      "item": [
        {
          "name": "2FA Challenge",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Challenge succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql(true);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "if (response?.data?.elevated_action_token) {",
                  "    pm.collectionVariables.set(",
                  "        'eat_token',",
                  "        response.data.elevated_action_token",
                  "    );",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totp_code\": \"{{totp_code}}\",\n  \"action_payload\": {\n    \"action\": \"swap\",\n    \"source_wallet_id\": \"{{ngn_wallet_id}}\",\n    \"destination_wallet_id\": \"{{cny_wallet_id}}\",\n    \"source_amount_subunits\": {{swap_amount_subunits}}\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/2fa/challenge",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "2fa",
                "challenge"
              ]
            }
          },
          "response": []
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{bearer_token}}",
            "type": "string"
          }
        ]
      }
    },
